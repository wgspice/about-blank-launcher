<!DOCTYPE html>
<html>
<body>

<button onclick="launch()">Open Website</button>

<script>
function launch() {
  const tab = window.open("about:blank", "_blank");

  tab.document.write(`
    <!DOCTYPE html>
    <html>
      <head>
        <title>Science Project</title>
      </head>
      <body style="margin:0">
        <iframe
          src="https://velara.cc"
          style="width:100%;height:100vh;border:0">
        </iframe>
      </body>
    </html>
  `);

  tab.document.close();
}
</script>

</body>
</html>
